CONFIG_TARGET_qualcommax=y
CONFIG_TARGET_qualcommax_ipq60xx=y
CONFIG_TARGET_qualcommax_ipq60xx_DEVICE_qihoo_360v6=y

# 适配360V6 1G CDT大分区
CONFIG_TARGET_ROOTFS_CDT=y
CONFIG_TARGET_ROOTFS_SQUASHFS=y

# USB存储驱动，U盘局域网共享
CONFIG_PACKAGE_kmod-usb-storage=y
CONFIG_PACKAGE_kmod-usb-ohci=y
CONFIG_PACKAGE_kmod-usb-uhci=y
CONFIG_PACKAGE_kmod-fs-ext4=y
CONFIG_PACKAGE_kmod-fs-ntfs3=y
CONFIG_PACKAGE_kmod-fs-vfat=y

# 业务组件：OpenClash / Samba / 下载工具
CONFIG_PACKAGE_luci-app-openclash=y
CONFIG_PACKAGE_samba4-server=y
CONFIG_PACKAGE_luci-app-samba4=y
CONFIG_PACKAGE_nfs-kernel-server=y
CONFIG_PACKAGE_transmission-daemon=y
CONFIG_PACKAGE_luci-app-transmission=y
CONFIG_PACKAGE_aria2=y
CONFIG_PACKAGE_luci-app-aria2=y
CONFIG_PACKAGE_luci-compat=y

# 裁剪：全部禁用不需要的包
CONFIG_PACKAGE_docker=
CONFIG_PACKAGE_luci-app-docker=
CONFIG_PACKAGE_luci-app-passwall=
CONFIG_PACKAGE_luci-app-sqm=
CONFIG_PACKAGE_luci-app-wol=
CONFIG_PACKAGE_python3=
CONFIG_PACKAGE_php8=
CONFIG_PACKAGE_rclone=
CONFIG_PACKAGE_luci-app-adguardhome=
